# Safe default: ClamAV starts only with a pre-provisioned verified database.
MAILPROOF_CLAMAV_PROVISION=none

# Immutable artifact mode (uncomment and fill all three values). This preserves
# reproducibility: the exact HTTPS artifact is SHA-256 verified before staging.
# MAILPROOF_CLAMAV_PROVISION=artifact
# MAILPROOF_CLAMAV_DATABASE=main
# MAILPROOF_CLAMAV_DATABASE_URL=https://approved.example/main.cvd
# MAILPROOF_CLAMAV_DATABASE_SHA256=replace-with-64-lowercase-hex-characters
# MAILPROOF_CLAMAV_DATABASE_VERSION=approved-release-id

# Mutable latest mode is opt-in. It uses freshclam during startup; enable the
# `clamav-updater` Compose profile for periodic refreshes. It is not a
# reproducible release input and its recorded provenance must be backed up.
# MAILPROOF_CLAMAV_PROVISION=latest
# MAILPROOF_CLAMAV_UPDATE_INTERVAL_SECONDS=21600
