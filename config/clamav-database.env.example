# Copy values into a protected change record and pass them as explicit flags to
# scripts/provision-clamav-db.sh. Do not put mutable feed URLs in Compose.
CLAMAV_DATABASE_URL=https://example.invalid/main.cvd
CLAMAV_DATABASE_SHA256=replace-with-64-lowercase-hex-characters
CLAMAV_DATABASE_VERSION=vendor-date-or-release-identifier
