compatibility_level = 3.6
myhostname = postfix.mailproof.test
mydomain = mailproof.test
mydestination =
inet_interfaces = all
inet_protocols = ipv4
relayhost =
relay_domains =
recipient_delimiter = +
message_size_limit = 52428800
smtp_tls_security_level = may
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, check_recipient_access texthash:/runtime/secrets/postfix-recipient-access, reject
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
virtual_transport = lmtp:inet:dovecot:24
virtual_mailbox_domains = $mydomain
virtual_mailbox_maps = static:verification
maillog_file = /var/log/mailproof/postfix.log
